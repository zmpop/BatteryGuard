#!/system/bin/sh
# Battery Guard - 面板接口：写入上下限（GET ?u=75&l=45）
# 返回 JSON：{"ok":true,"upper":75,"lower":45,"adjusted":false,"msg":"..."}
. /data/adb/modules/battery_guard/common/api.sh

printf 'Content-Type: application/json; charset=utf-8\r\n'
printf 'Cache-Control: no-store\r\n'
printf 'Connection: close\r\n\r\n'

u=""
l=""
_ifs=$IFS
IFS='&'
for kv in $QUERY_STRING; do
  case "$kv" in
    u=*) u=${kv#u=} ;;
    l=*) l=${kv#l=} ;;
  esac
done
IFS=$_ifs

api_set "${u:-}" "${l:-}"
