#!/sbin/sh
# Battery Guard - Magisk 模块安装器
# 用途：让本 zip 也能被第三方 Recovery（如 TWRP）识别并刷入。
#       通过 Magisk App 或 `magisk --install-module` 安装时不会用到本脚本。

umask 022

OUTFD=$2
ZIPFILE=$3

ui_print() {
  if [ -n "$OUTFD" ]; then
    echo "ui_print $1" >> /proc/self/fd/$OUTFD
    echo "ui_print" >> /proc/self/fd/$OUTFD
  else
    echo "$1"
  fi
}
abort() {
  ui_print " "
  ui_print "! 安装失败: $1"
  exit 1
}

ui_print "***************************************"
ui_print "  Battery Guard v1.0 安装器"
ui_print "***************************************"

[ -f "$ZIPFILE" ] || abort "取不到安装包路径"

# Recovery 环境下确保 /data 可用
mount /data 2>/dev/null
mount -o rw,remount /data 2>/dev/null

TMP=/tmp/battery_guard_install
rm -rf $TMP
mkdir -p $TMP || abort "无法创建临时目录"

unzip -o -q "$ZIPFILE" -d $TMP || abort "解压失败（Recovery 缺少 unzip）"
[ -f "$TMP/module.prop" ] || abort "安装包缺少 module.prop，请确认 zip 结构正确"

MODID=$(grep '^id=' "$TMP/module.prop" | head -n 1 | cut -d= -f2- | tr -d ' \r')
[ -n "$MODID" ] || MODID=battery_guard
ui_print "- 模块 ID: $MODID"

MODPATH=/data/adb/modules/$MODID
mkdir -p /data/adb/modules || abort "无法访问 /data/adb/modules，请确认已安装 Magisk"
rm -rf "$MODPATH"
mkdir -p "$MODPATH" || abort "无法创建模块目录"
cp -rf "$TMP"/. "$MODPATH"/ || abort "复制文件失败"
rm -rf "$MODPATH/META-INF"

chmod -R 0755 "$MODPATH" 2>/dev/null
find "$MODPATH" -type f -exec chmod 0644 {} \; 2>/dev/null
chmod 0755 "$MODPATH"/*.sh "$MODPATH"/common/*.sh 2>/dev/null
touch "$MODPATH/skip_mount" 2>/dev/null

# 以 source 方式执行 customize.sh，保证 ui_print 可用
if [ -f "$MODPATH/customize.sh" ]; then
  ui_print "- 执行 customize.sh"
  . "$MODPATH/customize.sh"
fi

rm -rf $TMP
ui_print "- 完成，请重启设备"
exit 0
